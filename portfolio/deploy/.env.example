# 域名（Caddy 自动申请 HTTPS 证书，需先把 DNS A 记录指向本 VPS）
DOMAIN=portfolio.example.com

# Resend 邮件服务（https://resend.com，需完成发信域名 DNS 验证）
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM=Stock Farmer <noreply@example.com>

# 会话签名密钥（务必改成随机长字符串，如 openssl rand -hex 32 生成）
SESSION_SECRET=change-me-to-a-long-random-string

# 可选：汇率覆盖（1 单位货币兑多少 USD）
# FX_HKD_USD=0.1282
# FX_CNY_USD=0.1395
